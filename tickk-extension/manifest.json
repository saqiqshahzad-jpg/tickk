{
  "manifest_version": 3,
  "name": "Tickk — Email Tracking",
  "version": "1.0.0",
  "description": "Track email opens and clicks directly from Gmail & Outlook. Know exactly when your emails are read.",

  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "alarms"
  ],

  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://tickk.online/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["shared.js", "gmail-content-script.js"],
      "css": ["content-style.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://outlook.live.com/*",
        "https://outlook.office.com/*"
      ],
      "js": ["shared.js", "outlook-content-script.js"],
      "css": ["content-style.css"],
      "run_at": "document_end"
    }
  ],

  "externally_connectable": {
    "matches": ["https://tickk.online/*"]
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
